# Provider utama: "gemini" (Google AI Studio, butuh internet), "blip" (model lokal), atau "mock" (dev/test)
CAPTION_PROVIDER=gemini

# --- Gemini -----------------------------------------------------------------
# Kunci dari https://aistudio.google.com/apikey — HANYA di berkas .env ini.
# Jangan ditulis di kode, extension, atau log. Berkas .env tidak masuk git (.gitignore).
GEMINI_API_KEY=
# Model Flash / Flash-Lite yang tersedia gratis di Google AI Studio (lihat daftar model di sana).
GEMINI_MODEL=
# Batas tunggu satu panggilan (detik). Gangguan jaringan / galat server Google diulang 1x.
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024
# Opsional: 0 mematikan "thinking" pada model 2.5 Flash agar lebih cepat. Kosong = bawaan model.
GEMINI_THINKING_BUDGET=

# Cadangan bila Gemini gagal (kuota habis/429, offline, kunci salah, JSON rusak): blip | mock | none
FALLBACK_PROVIDER=blip

# Contoh few-shot dari dataset kita (dibuat eval/make_fewshot.py). Kosong = eval/data/fewshot.json.
FEWSHOT_PATH=

# --- BLIP (lokal, offline) ----------------------------------------------------
# Nama model Hugging Face atau folder lokal hasil fine-tune (training/finetune_blip.ipynb).
# base ≈ 1 GB, cepat di CPU. large ≈ 1.8 GB, lebih akurat tapi lebih lambat.
BLIP_MODEL=Salesforce/blip-image-captioning-base
# Bahasa keluaran BLIP: en (lalu diterjemahkan) atau id (model hasil fine-tune bahasa Indonesia).
BLIP_LANG=en

# Model terjemahan Inggris → Indonesia (gratis, MarianMT)
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-id

# Sisi terpanjang gambar sebelum diproses (piksel)
MAX_IMAGE_SIDE=768
