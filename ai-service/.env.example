# Provider captioning: "blip" (model lokal), "mock" (dev/test), atau "gemini" (Google AI Studio)
CAPTION_PROVIDER=blip

# Model BLIP. base ≈ 1 GB, cepat di CPU. large ≈ 1.8 GB, lebih akurat tapi lebih lambat.
BLIP_MODEL=Salesforce/blip-image-captioning-base

# Model terjemahan Inggris → Indonesia (gratis, MarianMT)
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-id

# Provider Gemini (Google AI Studio) — wajib diisi bila CAPTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sisi terpanjang gambar sebelum diproses (piksel)
MAX_IMAGE_SIDE=768
