{
  "name": "naravisi-backend",
  "version": "0.5.0",
  "description": "REST API NaraVisi (Node.js 22 + Express 5)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.11.0"
  }
}
