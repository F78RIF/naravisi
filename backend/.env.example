# --- Mode -----------------------------------------------------------------
# development = di laptop sendiri (boleh tanpa kunci; pembayaran SIMULASI lokal)
# production  = dipakai orang lain lewat internet. Server MENOLAK start bila salah satu kosong/salah:
#               JWT_SECRET (>= 32 karakter), PUBLIC_URL (https://), ALLOWED_ORIGINS, MIDTRANS_SERVER_KEY (Sandbox),
#               MIDTRANS_IS_PRODUCTION=false. Halaman simulasi pembayaran tidak tersedia.
APP_ENV=development

# --- Server ---------------------------------------------------------------
PORT=3000
# Alamat publik server (dipakai untuk halaman pembayaran & redirect Midtrans). Production: wajib https://
PUBLIC_URL=http://localhost:3000

# --- Basis data -----------------------------------------------------------
# mysql (sesuai SRS) atau sqlite (demo cepat tanpa MySQL)
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=naravisi
SQLITE_PATH=./data/naravisi.sqlite

# --- Keamanan -------------------------------------------------------------
# WAJIB diisi (server menolak start bila kosong, kecuali NODE_ENV=development/test).
# Ganti dengan teks acak panjang (mis. hasil: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Origin yang boleh memanggil API dari browser, pisahkan dengan koma.
# Isi dengan ID extension dari chrome://extensions, mis. chrome-extension://abcdefghijklmnop
# Kosong (development) = hanya http://localhost dan http://127.0.0.1.
ALLOWED_ORIGINS=

# Akun Admin awal (dibuat oleh: npm run db:setup). Isi sandi sendiri; kosong = Admin tidak dibuat.
ADMIN_NAME=Admin NaraVisi
ADMIN_EMAIL=admin@naravisi.local
ADMIN_PASSWORD=

# --- Aturan bisnis --------------------------------------------------------
APP_TZ=Asia/Makassar
FREE_DAILY_QUOTA=10
FREE_HISTORY_DAYS=7

# --- Layanan AI -----------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
# Batas tunggu model AI. Harus di bawah batas tunggu extension (30 dtk); model di CPU
# yang berbagi prosesor dengan browser bisa butuh >15 dtk (uji M-01).
AI_TIMEOUT_MS=25000
MAX_IMAGE_BYTES=5242880

# --- Midtrans -------------------------------------------------------------
# development: kosongkan untuk mode SIMULASI lokal (tanpa akun Midtrans).
# production : WAJIB diisi Server Key Sandbox dari dashboard.sandbox.midtrans.com → Settings → Access Keys.
MIDTRANS_SERVER_KEY=
# Tetap false: NaraVisi memakai Midtrans Sandbox (tidak ada uang sungguhan yang ditagih).
MIDTRANS_IS_PRODUCTION=false
