digraph ERD {
graph [rankdir=LR, splines=polyline, nodesep=0.6, ranksep=1.1, pad=0.3, fontname="DejaVu Sans"];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowsize=0.8];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="user_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="nama" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>nama</b></td><td align="left"><font color="#333333">VARCHAR(100)</font></td></tr><tr><td align="left" port="email" bgcolor="#ffffff"><font color="#555555">UQ</font></td><td align="left"><b>email</b></td><td align="left"><font color="#333333">VARCHAR(100)</font></td></tr><tr><td align="left" port="kata_sandi" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>kata_sandi</b></td><td align="left"><font color="#333333">VARCHAR(255) hash</font></td></tr><tr><td align="left" port="peran" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>peran</b></td><td align="left"><font color="#333333">ENUM('pengguna','admin')</font></td></tr><tr><td align="left" port="status_akun" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>status_akun</b></td><td align="left"><font color="#333333">ENUM('aktif','nonaktif')</font></td></tr><tr><td align="left" port="tanggal_registrasi" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal_registrasi</b></td><td align="left"><font color="#333333">DATETIME</font></td></tr></table>>];
pengaturan_aksesibilitas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>pengaturan_aksesibilitas</b></font></td></tr><tr><td align="left" port="pengaturan_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>pengaturan_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK UQ</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="bahasa_deskripsi" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>bahasa_deskripsi</b></td><td align="left"><font color="#333333">VARCHAR(10)</font></td></tr><tr><td align="left" port="pintasan_keyboard" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>pintasan_keyboard</b></td><td align="left"><font color="#333333">VARCHAR(50)</font></td></tr><tr><td align="left" port="kecepatan_suara" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>kecepatan_suara</b></td><td align="left"><font color="#333333">DECIMAL(3,1)</font></td></tr><tr><td align="left" port="nada_suara" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>nada_suara</b></td><td align="left"><font color="#333333">DECIMAL(3,1)</font></td></tr><tr><td align="left" port="jenis_suara" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>jenis_suara</b></td><td align="left"><font color="#333333">VARCHAR(100) NULL</font></td></tr></table>>];
kuota_harian [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>kuota_harian</b></font></td></tr><tr><td align="left" port="kuota_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>kuota_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="tanggal" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal</b></td><td align="left"><font color="#333333">DATE</font></td></tr><tr><td align="left" port="jumlah_permintaan" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>jumlah_permintaan</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="x4" bgcolor="#ffffff"><font color="#555555">UQ</font></td><td align="left"><b>(user_id, tanggal)</b></td><td align="left"><font color="#333333">&#160;</font></td></tr></table>>];
riwayat_deskripsi [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>riwayat_deskripsi</b></font></td></tr><tr><td align="left" port="riwayat_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>riwayat_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="url_halaman" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>url_halaman</b></td><td align="left"><font color="#333333">TEXT</font></td></tr><tr><td align="left" port="url_gambar" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>url_gambar</b></td><td align="left"><font color="#333333">TEXT NULL</font></td></tr><tr><td align="left" port="teks_deskripsi" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>teks_deskripsi</b></td><td align="left"><font color="#333333">TEXT</font></td></tr><tr><td align="left" port="waktu_dibuat" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>waktu_dibuat</b></td><td align="left"><font color="#333333">DATETIME</font></td></tr><tr><td align="left" port="x6" bgcolor="#ffffff"><font color="#555555">IDX</font></td><td align="left"><b>(user_id, waktu_dibuat)</b></td><td align="left"><font color="#333333">&#160;</font></td></tr></table>>];
laporan_deskripsi [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>laporan_deskripsi</b></font></td></tr><tr><td align="left" port="laporan_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>laporan_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="riwayat_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>riwayat_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT (pelapor)</font></td></tr><tr><td align="left" port="admin_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>admin_id</b></td><td align="left"><font color="#333333">INT NULL (peninjau)</font></td></tr><tr><td align="left" port="alasan" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>alasan</b></td><td align="left"><font color="#333333">TEXT</font></td></tr><tr><td align="left" port="status_laporan" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>status_laporan</b></td><td align="left"><font color="#333333">ENUM('baru','ditinjau')</font></td></tr><tr><td align="left" port="tindak_lanjut" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tindak_lanjut</b></td><td align="left"><font color="#333333">TEXT NULL</font></td></tr><tr><td align="left" port="tanggal_laporan" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal_laporan</b></td><td align="left"><font color="#333333">DATETIME</font></td></tr><tr><td align="left" port="tanggal_tinjau" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal_tinjau</b></td><td align="left"><font color="#333333">DATETIME NULL</font></td></tr></table>>];
paket_premium [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>paket_premium</b></font></td></tr><tr><td align="left" port="paket_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>paket_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="nama_paket" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>nama_paket</b></td><td align="left"><font color="#333333">VARCHAR(50)</font></td></tr><tr><td align="left" port="harga" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>harga</b></td><td align="left"><font color="#333333">DECIMAL(10,2)</font></td></tr><tr><td align="left" port="durasi_hari" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>durasi_hari</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="manfaat" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>manfaat</b></td><td align="left"><font color="#333333">TEXT</font></td></tr><tr><td align="left" port="aktif" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>aktif</b></td><td align="left"><font color="#333333">TINYINT(1)</font></td></tr></table>>];
transaksi [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>transaksi</b></font></td></tr><tr><td align="left" port="transaksi_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>transaksi_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT NULL</font></td></tr><tr><td align="left" port="paket_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>paket_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="order_id" bgcolor="#ffffff"><font color="#555555">UQ</font></td><td align="left"><b>order_id</b></td><td align="left"><font color="#333333">VARCHAR(100)</font></td></tr><tr><td align="left" port="metode_pembayaran" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>metode_pembayaran</b></td><td align="left"><font color="#333333">VARCHAR(30)</font></td></tr><tr><td align="left" port="jumlah" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>jumlah</b></td><td align="left"><font color="#333333">DECIMAL(10,2)</font></td></tr><tr><td align="left" port="status_pembayaran" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>status_pembayaran</b></td><td align="left"><font color="#333333">ENUM('menunggu','berhasil',<br/>'gagal','kedaluwarsa')</font></td></tr><tr><td align="left" port="waktu_transaksi" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>waktu_transaksi</b></td><td align="left"><font color="#333333">DATETIME</font></td></tr><tr><td align="left" port="waktu_bayar" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>waktu_bayar</b></td><td align="left"><font color="#333333">DATETIME NULL</font></td></tr></table>>];
langganan [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#111111"><tr><td colspan="3" bgcolor="#0b57d0"><font color="white"><b>langganan</b></font></td></tr><tr><td align="left" port="langganan_id" bgcolor="#fff4d6"><font color="#555555">PK</font></td><td align="left"><b>langganan_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="user_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>user_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="paket_id" bgcolor="#ffffff"><font color="#555555">FK</font></td><td align="left"><b>paket_id</b></td><td align="left"><font color="#333333">INT</font></td></tr><tr><td align="left" port="transaksi_id" bgcolor="#ffffff"><font color="#555555">FK UQ</font></td><td align="left"><b>transaksi_id</b></td><td align="left"><font color="#333333">INT NULL</font></td></tr><tr><td align="left" port="tanggal_mulai" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal_mulai</b></td><td align="left"><font color="#333333">DATE</font></td></tr><tr><td align="left" port="tanggal_berakhir" bgcolor="#ffffff"><font color="#555555">&#160;</font></td><td align="left"><b>tanggal_berakhir</b></td><td align="left"><font color="#333333">DATE</font></td></tr></table>>];
users -> pengaturan_aksesibilitas [xlabel="memiliki\n1 : 1", arrowhead=tee, arrowtail=tee, dir=both];
users -> kuota_harian [xlabel="memiliki\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
users -> riwayat_deskripsi [xlabel="menghasilkan\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
riwayat_deskripsi -> laporan_deskripsi [xlabel="dilaporkan\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
users -> laporan_deskripsi [xlabel="melaporkan / meninjau\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
users -> transaksi [xlabel="melakukan\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
paket_premium -> transaksi [xlabel="dipilih pada\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
users -> langganan [xlabel="berlangganan\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
paket_premium -> langganan [xlabel="mendasari\n1 : N", arrowhead=crow, arrowtail=tee, dir=both];
transaksi -> langganan [xlabel="menghasilkan\n1 : 0..1", arrowhead=teeodot, arrowtail=tee, dir=both];
