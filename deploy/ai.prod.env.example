# NaraVisi · deploy/ai.prod.env.example — salin menjadi deploy/ai.prod.env di VM lalu isi.
# JANGAN di-commit (.gitignore: *.env). APP_ENV=production diatur docker-compose.prod.yml.

CAPTION_PROVIDER=gemini
# Kunci gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Flash / Flash-Lite yang tersedia gratis di Google AI Studio
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_BUDGET=

# Cadangan saat kuota Gemini habis (wajib blip di production). Model diunduh sekali ke volume ai-models (± 1,3 GB).
FALLBACK_PROVIDER=blip
BLIP_MODEL=Salesforce/blip-image-captioning-base
BLIP_LANG=en
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-id
MAX_IMAGE_SIDE=768
