# NaraVisi · deploy/backend.prod.env.example — salin menjadi deploy/backend.prod.env di VM lalu isi.
# JANGAN di-commit (.gitignore: *.env). APP_ENV, PUBLIC_URL, MYSQL_*, AI_SERVICE_URL, TRUST_PROXY sudah diatur
# oleh docker-compose.prod.yml, jadi tidak perlu ditulis di sini.

# Teks acak >= 32 karakter:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Origin extension, mis. chrome-extension://<ID extension> (lihat docs/PASANG_EXTENSION.md, dibuat di Langkah 4)
ALLOWED_ORIGINS=

# Akun Admin awal (dibuat otomatis saat backend start bila belum ada). Pakai sandi kuat: Dashboard Admin terbuka di internet.
ADMIN_NAME=Admin NaraVisi
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Midtrans SANDBOX: dashboard.sandbox.midtrans.com -> Settings -> Access Keys -> Server Key
MIDTRANS_SERVER_KEY=

APP_TZ=Asia/Makassar
FREE_DAILY_QUOTA=10
FREE_HISTORY_DAYS=7
AI_TIMEOUT_MS=25000
MAX_IMAGE_BYTES=5242880
